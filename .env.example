# Copy to .env.local to override the defaults from .env.

# Base URL of the REST API.
VITE_API_URL=/api

# Socket.IO server origin. Empty uses the page origin (served by the mock layer).
VITE_REALTIME_URL=

# "true" serves the API from the MSW mock layer; "false" calls VITE_API_URL.
VITE_ENABLE_MOCKS=true

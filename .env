# Non-secret defaults shared by dev, demo build and tests.
# Override locally in .env.local (ignored by git).

# Base URL of the REST API.
VITE_API_URL=/api

# Socket.IO server origin. Empty uses the page origin (served by the mock layer).
VITE_REALTIME_URL=

# Serve the API from the MSW mock layer (there is no real backend).
VITE_ENABLE_MOCKS=true
